# Hugging Face token — needed for pyannote (episode-1 diarization). Accept the model terms first:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
#   https://huggingface.co/pyannote/segmentation-3.0
HF_TOKEN=
# Optional: force a path profile (macos | vm). Auto-detected otherwise.
# SURVSPK_PROFILE=macos
# Plex (for `survspk fetch-subs`): server URL and token. Token: Plex Web -> any item -> ... -> Get Info
# -> View XML -> the X-Plex-Token in the URL.
PLEX_URL=http://localhost:32400
PLEX_TOKEN=

# local LLM for `survspk text-prior` (oMLX, OpenAI-compatible)
OMLX_BASE_URL=http://127.0.0.1:8001/v1
OMLX_API_KEY=
OMLX_MODEL=Qwen3.6-35B-A3B-MLX-8bit
